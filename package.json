{
  "name": "kitto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib queries",
    "typecheck": "tsc --noEmit",
    "build:native:dev": "dotenv -e .env.native-dev.local -- next build",
    "build:native:prod": "next build",
    "cap:sync:dev": "npm run build:native:dev && npx cap sync && ./scripts/patch-ios-plist.sh --local-http",
    "cap:sync:prod": "npm run build:native:prod && npx cap sync && ./scripts/patch-ios-plist.sh",
    "lan:ip": "./scripts/lan-ip.sh",
    "ios:check": "./scripts/check-ios-backend.sh",
    "ios:check:device": "./scripts/check-ios-backend.sh --device",
    "icons": "node scripts/build-app-icon.mjs && npx capacitor-assets generate --ios",
    "ios:dev": "./scripts/patch-ios-plist.sh --local-http && cross-env CAP_LIVE_RELOAD_URL=http://$(./scripts/lan-ip.sh):3000 npx cap run ios",
    "android:dev": "cross-env CAP_LIVE_RELOAD_URL=http://192.168.1.4:3000 npx cap run android",
    "ios:device": "npm run cap:sync:dev && npm run icons && npx cap open ios",
    "ios:open": "npm run cap:sync:prod && npm run icons && npx cap open ios",
    "android:open": "npm run cap:sync:prod && npx cap open android",
    "cap:doctor": "npx cap doctor"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.0.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
