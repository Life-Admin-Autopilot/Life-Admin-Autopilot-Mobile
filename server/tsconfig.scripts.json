{
  // The eval/probe scripts were never typechecked: tsconfig.json includes only
  // `src/**/*`, and tsx strips types without checking them. That is how
  // nl-eval.ts came to call getSystemPrompt() with no argument for as long as
  // it did — the LANGUAGE rule rendered as "Write every word the user will read
  // in undefined." and every multi-language case was graded against it.
  //
  // Run with `npm run type-check:scripts`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["scripts/**/*", "src/**/*"]
}
