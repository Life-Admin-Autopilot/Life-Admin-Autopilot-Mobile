# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Comma-separated origins allowed by CORS (server/src/app.ts buildCorsOptions).
# Every origin that will fetch this API must be listed — unlisted origins are
# rejected outright, never reflected. Add your deployed web origin in prod.
#   http://localhost:3000    Next dev server (web browser dev)
#   capacitor://localhost    iOS Capacitor WebView origin
#   http://localhost         Android Capacitor WebView origin
#   http://192.168.x.x:3000  Your LAN IP, only needed while using Capacitor
#                            live-reload (ios:dev/android:dev) — the webview's
#                            origin becomes the live-reload server's origin
#                            instead of capacitor://localhost while active.
#                            Replace with your real LAN IP; update on network change.
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost,http://192.168.1.4:3000

# Mongo
# Local: brew install mongodb-community && brew services start mongodb-community
# Atlas: paste the connection string from mongodb.com/atlas (free tier M0 is fine)
MONGODB_URI=mongodb://localhost:27017/life_admin

# JWT secrets — generate each one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-64-byte-hex-string
JWT_REFRESH_SECRET=replace-me-with-a-different-64-byte-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Email — resend.com
# Leave RESEND_API_KEY blank in dev to log emails to console instead of sending.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Deep link scheme — used in verification + magic-link redirect URLs back to the RN app.
APP_DEEP_LINK_SCHEME=lifeadmin

# AI — Gemini. Leave GEMINI_API_KEY blank to boot without AI (/ai/* returns
# 503 ai_not_configured). Get a key at https://aistudio.google.com/apikey
# Pin BOTH model ids to a REAL, released model. 'gemini-2.5-flash' is the
# current default for both chat (GEMINI_MODEL) and voice extraction
# (GEMINI_STRONG_MODEL). Do NOT set a non-existent id like 'gemini-3.5-flash'
# — the provider 404s and extraction silently returns nothing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STRONG_MODEL=gemini-2.5-flash

# Daily message quotas per tier. Tuned via env so ops doesn't need a deploy.
AI_QUOTA_FREE_DAILY=30
AI_QUOTA_PRO_DAILY=300

# Document scanning — all optional, sensible defaults in server/src/env.ts.
# DOCUMENT_SCAN_STORAGE_DIR=./uploads/document-scans
# DOCUMENT_SCAN_MAX_BYTES=15728640
# DOCUMENT_SCAN_MAX_PAGES=20
# DOCUMENT_SCAN_QUOTA_FREE_MONTHLY=20
# DOCUMENT_SCAN_QUOTA_PRO_MONTHLY=200
