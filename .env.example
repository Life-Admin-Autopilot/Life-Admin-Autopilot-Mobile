# Public client config (Next inlines NEXT_PUBLIC_* at build time).
# There are three profiles, each loaded by a different npm script — see
# docs/CAPACITOR.md for the full pipeline.

# --- Web dev (browser, `npm run dev`) — copy this section into .env.local ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Native dev (device/simulator via Capacitor) ---
# Copy into .env.native-dev.local (gitignored, per-developer — do NOT commit
# your real LAN IP). Find your LAN IP with `ipconfig` (Windows, look for the
# active adapter's IPv4 Address). The phone/emulator and this machine must be
# on the same network; the Express server binds 0.0.0.0 by default, so no
# server change is needed beyond CORS_ORIGINS (see server/.env.example).
# NEXT_PUBLIC_API_URL=http://192.168.1.4:4000

# --- Production (native prod build + prod web deploy) ---
# Copy into .env.production (committed — public value only, no secrets)
# NEXT_PUBLIC_API_URL=https://api.example.com
