.next/
out/
build/
dist/

# Capacitor native projects (generated; regenerate with `npx cap add`)
/ios/
/android/

# Backend — lives outside this repo
# /server

# Runtime upload artifacts written by the document-scan storage adapter —
# user data, not source. Regenerated per environment.
server/uploads/

# Design reference dumps (third-party app screenshots) — kept locally, far too
# large to version.
/Tiimo ios Feb 2026/

# Env / secrets — NEVER commit real values
.env
.env.local
.env.*.local
server/.env

# pdf.js runtime assets, vendored out of node_modules by scripts/copy-pdfjs-assets.mjs
# (worker, cmaps, standard fonts, wasm codecs). Generated — never edited here.
/public/pdfjs/

# Misc
.DS_Store
*.log
npm-debug.log*
.vscode/*
!.vscode/extensions.json
coverage/
.turbo/

# TypeScript / Next
*.tsbuildinfo
next-env.d.ts

# Agent scratch worktrees — a nested git repo, never ours to commit.
.claude/worktrees/

# Firebase Android config. Not committed by default: it carries an API key, and
# this repo has a secret purge in its history. Google treats it as non-secret
# (it ships inside every APK, and the key is restricted to the package id), so
# committing it is defensible — delete this line if the team prefers a clone
# that works without a hand-over. scripts/patch-android-firebase.mjs copies it
# into the regenerated android/ project.
/native/android/google-services.json
